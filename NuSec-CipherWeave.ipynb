import numpy as np
import ipywidgets as widgets
from IPython.display import display, HTML
import base64

# ---------- 1) CORE ----------
def build_encryption_matrix():
    m = np.zeros((256, 256), dtype=int)
    for i in range(256):
        for j in range(256):
            m[i][j] = (j + i) % 256
    return m

ENC_MATRIX = build_encryption_matrix()
ROW0 = {int(ENC_MATRIX[0][c]): c for c in range(256)}
COL0 = {int(ENC_MATRIX[r][0]): r for r in range(256)}

def encrypt_bytes(data: bytes, key: str) -> bytes:
    if not key: raise ValueError("Key cannot be empty.")
    kb = [ord(c) for c in key]; kl = len(kb); out = bytearray()
    for i, p in enumerate(data):
        out.append(int(ENC_MATRIX[COL0[p]][ROW0[kb[i % kl]]]))
    return bytes(out)

def decrypt_bytes(data: bytes, key: str) -> bytes:
    if not key: raise ValueError("Key cannot be empty.")
    kb = [ord(c) for c in key]; kl = len(kb); out = bytearray()
    for i, c in enumerate(data):
        col = ROW0[kb[i % kl]]
        out.append(int(ENC_MATRIX[(c - col) % 256][0]))
    return bytes(out)

# ---------- 2) ROBUST UPLOAD READER ----------
def _to_bytes(x):
    if isinstance(x, bytes):       return x
    if isinstance(x, bytearray):   return bytes(x)
    if isinstance(x, memoryview):  return x.tobytes()
    if isinstance(x, str):         return x.encode("utf-8")
    if isinstance(x, (list, tuple)):
        try:    return bytes(x)
        except Exception: pass
    raise TypeError(f"Cannot convert {type(x).__name__} to bytes")

def read_uploaded():
    val = file_upload.value
    if not val:
        raise ValueError("Please upload a file first.")

    def extract(entry):
        if isinstance(entry, dict) and "content" in entry:
            nm = entry.get("name") or entry.get("filename") or None
            return nm, _to_bytes(entry["content"])
        if isinstance(entry, (bytes, bytearray, memoryview)):
            return None, _to_bytes(entry)
        if isinstance(entry, (list, tuple)) and all(isinstance(x, int) for x in entry):
            return None, bytes(entry)
        return None, None

    if isinstance(val, (list, tuple)) and val:
        for entry in val:
            nm, data = extract(entry)
            if data is not None:
                return (nm or "uploaded.bin"), data
        raise ValueError(f"Unexpected list payload: {val!r}")

    if isinstance(val, dict):
        nm, data = extract(val)
        if data is not None:
            return (nm or "uploaded.bin"), data
        for k, v in val.items():
            nm, data = extract(v)
            if data is not None:
                return (k or nm or "uploaded.bin"), data
        raise ValueError(
            f"Could not find file content. keys={list(val.keys())!r}, "
            f"value types={[type(x).__name__ for x in val.values()]!r}"
        )

    raise ValueError(f"Unknown FileUpload.value type: {type(val)}")

# ---------- 3) UI ----------
W = "720px"
header = widgets.HTML(
    "<div style='font-family:system-ui;padding:6px 0'>"
    "<h2 style='color:#0b6e4f;margin:0'>🔐 NuSec-CipherWeave</h2>"
    "<p style='color:#555;margin:4px 0 0'>256×256 matrix cipher — text or files.</p></div>"
)
key_input = widgets.Password(description="🔑 Key:", placeholder="enter key",
                             layout=widgets.Layout(width=W))

# TEXT TAB
text_input  = widgets.Textarea(placeholder="Type the text…", layout=widgets.Layout(width=W, height="120px"))
text_output = widgets.Textarea(layout=widgets.Layout(width=W, height="120px"), disabled=True)
text_log    = widgets.Output(layout=widgets.Layout(border="1px solid #ddd", padding="8px", min_height="60px"))

def run_text(mode):
    text_log.clear_output()
    try:
        key = key_input.value.strip()
        if not key: raise ValueError("Please enter a key first.")
        src = text_input.value
        if not src: raise ValueError("Please enter some text.")
        with text_log:
            if mode == "enc":
                raw = encrypt_bytes(src.encode("utf-8"), key)
                text_output.value = raw.decode("latin-1")
                print(f"✅ Encrypted {len(src)} chars → {len(raw)} bytes.")
                print("🔓 Round-trip:", "OK ✅" if decrypt_bytes(raw, key).decode("utf-8","replace")==src else "FAILED ❌")
            else:
                raw = src.encode("latin-1", "replace")
                out = decrypt_bytes(raw, key).decode("utf-8", "replace")
                text_output.value = out
                print(f"✅ Decrypted {len(raw)} bytes → {len(out)} chars.")
    except Exception as e:
        with text_log: print(f"❌ {type(e).__name__}: {e}")

b1 = widgets.Button(description="🔒 Encrypt Text", button_style="success", layout=widgets.Layout(width="160px"))
b2 = widgets.Button(description="🔓 Decrypt Text", button_style="info",    layout=widgets.Layout(width="160px"))
b1.on_click(lambda _: run_text("enc")); b2.on_click(lambda _: run_text("dec"))

tab_text = widgets.VBox([
    widgets.HTML("<b>Input</b>"), text_input,
    widgets.HBox([b1, b2]),
    widgets.HTML("<b>Output</b>"), text_output, text_log,
])

# FILE TAB
file_upload = widgets.FileUpload(accept=".txt,.md,.csv,.log,.json,.py,.enc",
                                 multiple=False, layout=widgets.Layout(width=W))
file_log = widgets.Output(layout=widgets.Layout(border="1px solid #ddd", padding="8px", min_height="60px"))
dl_out   = widgets.Output()

def show_download(name, data):
    b64 = base64.b64encode(data).decode()
    with dl_out:
        dl_out.clear_output()
        display(HTML(f'<a download="{name}" '
                     f'href="data:application/octet-stream;base64,{b64}" '
                     f'style="display:inline-block;padding:10px 18px;background:#0b6e4f;'
                     f'color:#fff;border-radius:6px;text-decoration:none;font-family:system-ui;">'
                     f'⬇️ Download "{name}" ({len(data)} bytes)</a>'))

def run_file(mode):
    file_log.clear_output(); dl_out.clear_output()
    try:
        key = key_input.value.strip()
        if not key: raise ValueError("Please enter a key first.")
        name, data = read_uploaded()
        with file_log:
            print(f"📄 Loaded: {name!r}  ({len(data)} bytes)")
            if len(data) <= 4:
                print(f"   raw = {data!r}")
                print("⚠️ File is empty or almost empty — check that you picked the right file.")
        out = encrypt_bytes(data, key) if mode == "enc" else decrypt_bytes(data, key)
        out_name = (name + ".enc") if mode == "enc" else (name[:-4] if name.endswith(".enc") else name + ".dec")
        show_download(out_name, out)
        with file_log: print(f"✅ Done → {out_name} ({len(out)} bytes)")
    except Exception as e:
        with file_log: print(f"❌ {type(e).__name__}: {e}")

bf1 = widgets.Button(description="🔒 Encrypt File", button_style="success", layout=widgets.Layout(width="160px"))
bf2 = widgets.Button(description="🔓 Decrypt File", button_style="info",    layout=widgets.Layout(width="160px"))
bf1.on_click(lambda _: run_file("enc")); bf2.on_click(lambda _: run_file("dec"))
file_upload.observe(lambda ch: (file_log.clear_output(), dl_out.clear_output()), names="value")

tab_file = widgets.VBox([
    widgets.HTML("<b>1) Upload a file</b>"), file_upload,
    widgets.HTML("<b>2) Choose action</b>"), widgets.HBox([bf1, bf2]),
    widgets.HTML("<b>3) Result</b>"), dl_out, file_log,
])

# INFO TAB
tab_info = widgets.HTML(
    "<div style='font-family:system-ui;max-width:760px;line-height:1.55'>"
    "<h3>How it works</h3>"
    "<p>Matrix rule: <code>M[i][j] = (i + j) mod 256</code> — every row and column has 0–255 exactly once.</p>"
    "<ul><li><b>Encrypt</b>: <code>r = row(M[r][0]==plain)</code>, <code>c = col(M[0][c]==key)</code>, "
    "cipher = <code>M[r][c]</code>.</li>"
    "<li><b>Decrypt</b>: <code>c = col(M[0][c]==key)</code>, <code>r = (cipher − c) mod 256</code>, "
    "plain = <code>M[r][0]</code>.</li></ul>"
    "<p>Files are processed byte-by-byte → any content round-trips losslessly.</p>"
    "<p style='color:#a00'><b>Security note:</b> matrix is public — educational only.</p>"
    "</div>")

tabs = widgets.Tab(children=[tab_text, tab_file, tab_info])
tabs.set_title(0, "📝 Text"); tabs.set_title(1, "📁 File"); tabs.set_title(2, "ℹ️ Info")

display(widgets.VBox([header, key_input, tabs],
      layout=widgets.Layout(padding="10px", border="1px solid #e0e0e0", border_radius="8px")))
print(f"ℹ️ ipywidgets {widgets.__version__}")
